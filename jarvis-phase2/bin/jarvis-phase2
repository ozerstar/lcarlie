#!/bin/sh
set -eu

if [ "${JARVIS_ENABLED:-false}" != "true" ]; then
  printf '%s\n' '{"status":"DISABLED","reason":"JARVIS_ENABLED is not true"}'
  exit 78
fi

if [ "${JARVIS_MODE:-}" != "SHADOW" ] || [ "${EXTERNAL_ACTIONS:-true}" != "false" ]; then
  printf '%s\n' '{"status":"BLOCKED","reason":"strict shadow environment required"}' >&2
  exit 78
fi

cd /opt/lcarlie/jarvis-phase2
exec python3 -m jarvis.shadow "$@"
