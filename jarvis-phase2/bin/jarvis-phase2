#!/bin/sh
set -eu

if [ "${JARVIS_ENABLED:-false}" != "true" ]; then
  printf '%s\n' '{"status":"DISABLED","reason":"JARVIS_ENABLED is not true"}'
  exit 78
fi

if [ "${EXTERNAL_ACTIONS:-true}" != "false" ]; then
  printf '%s\n' '{"status":"BLOCKED","reason":"external actions must stay disabled"}' >&2
  exit 78
fi

cd /opt/lcarlie/jarvis-phase2

case "${JARVIS_MODE:-}" in
  SHADOW)
    exec python3 -m jarvis.shadow "$@"
    ;;
  OPERATIONAL)
    exec python3 -m jarvis.loop_cli "$@"
    ;;
  *)
    printf '%s\n' '{"status":"BLOCKED","reason":"JARVIS_MODE must be SHADOW or OPERATIONAL"}' >&2
    exit 78
    ;;
esac
