#!/bin/sh
set -eu

if [ "${JARVIS_ENABLED:-false}" != "true" ]; then
  printf '%s\n' '{"status":"DISABLED","reason":"JARVIS_ENABLED is not true"}'
  exit 78
fi

if [ "${EXTERNAL_ACTIONS:-true}" != "false" ]; then
  printf '%s\n' '{"status":"BLOCKED","reason":"external actions must stay disabled"}' >&2
  exit 78
fi

# Istege bagli kutuphaneler (zeyrek morfolojisi, trafilatura tarih cikarimi)
# venv'de kurulu. Sistem python'u onlari goremez ve servis sessizce daha az
# yetenekli calisir -- jarvis-web venv kullandigi icin panel ile dongu
# farkli davraniyordu. venv yoksa python3'e dusulur.
JARVIS_PY=/opt/lcarlie/jarvis-phase2/venv/bin/python
[ -x "$JARVIS_PY" ] || JARVIS_PY=python3

cd /opt/lcarlie/jarvis-phase2

case "${JARVIS_MODE:-}" in
  SHADOW)
    exec "$JARVIS_PY" -m jarvis.shadow "$@"
    ;;
  OPERATIONAL)
    exec "$JARVIS_PY" -m jarvis.loop_cli "$@"
    ;;
  *)
    printf '%s\n' '{"status":"BLOCKED","reason":"JARVIS_MODE must be SHADOW or OPERATIONAL"}' >&2
    exit 78
    ;;
esac
