[Unit]
Description=Finans merkezi urun maliyeti -> core.urun_maliyet (tek kaynak, 15.11.2026)
After=network-online.target docker.service

[Service]
Type=oneshot
User=jarvis-web
Group=jarvis-web
Environment=JARVIS_DB_HOST=127.0.0.1
Environment=JARVIS_DB_PORT=5433
Environment=JARVIS_DB_PASSWORD_FILE=/etc/lcarlie/jarvis-web-db.pass
Environment=JARVIS_STATE_DIR=/opt/lcarlie/jarvis-phase2/state
Environment=JARVIS_WEB_STATE_DIR=/opt/lcarlie/jarvis-phase2/state/webconsole
Environment=JARVIS_FINANS_SAHIBI=operator
ExecStart=/opt/lcarlie/jarvis-phase2/venv/bin/python /opt/lcarlie/jarvis-phase2/scripts/finans-maliyet-aktar.py
TimeoutStartSec=10min
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/lcarlie/jarvis-phase2/state
MemoryMax=512M
