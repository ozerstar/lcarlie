[Unit]
Description=LCARLIE Jarvis Phase 2 (disabled proposal)
After=network-online.target docker.service

[Service]
Type=oneshot
User=nobody
Group=nogroup
Environment=JARVIS_ENABLED=false
EnvironmentFile=-/etc/lcarlie/jarvis-phase2.env
ExecStart=/opt/lcarlie/jarvis-phase2/bin/jarvis-phase2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
MemoryMax=256M
CPUQuota=100%
TasksMax=64

# Intentionally no [Install] section. Activation remains manual and proposed.
