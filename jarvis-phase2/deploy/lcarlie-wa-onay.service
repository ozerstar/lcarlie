[Unit]
Description=LCARLIE bekleyen onaylari WhatsApp'tan sahibe gonderir, dugme yanitiyla karar verir
After=network-online.target docker.service lcarlie-meta-kuyruk-yukle.service
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/lcarlie/jarvis-phase2
EnvironmentFile=/etc/lcarlie/jarvis-web.env
Environment=JARVIS_STATE_DIR=/opt/lcarlie/jarvis-phase2/state
ExecStart=/usr/bin/flock -n /run/lcarlie-wa-onay.lock /opt/lcarlie/jarvis-phase2/venv/bin/python /opt/lcarlie/jarvis-phase2/scripts/wa-onay.py
TimeoutStartSec=180
NoNewPrivileges=true
UMask=0077
