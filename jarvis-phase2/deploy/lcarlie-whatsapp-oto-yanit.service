[Unit]
Description=LCARLIE WhatsApp incoming message auto replies
After=network-online.target docker.service lcarlie-meta-kuyruk-yukle.service
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/lcarlie/jarvis-phase2
EnvironmentFile=/etc/lcarlie/jarvis-web.env
EnvironmentFile=/etc/lcarlie/whatsapp-auto.env
Environment=JARVIS_STATE_DIR=/opt/lcarlie/jarvis-phase2/state
ExecStart=/usr/bin/flock -n /run/lcarlie-whatsapp-oto.lock /opt/lcarlie/jarvis-phase2/venv/bin/python /opt/lcarlie/jarvis-phase2/scripts/whatsapp_oto_yanit.py
TimeoutStartSec=180
NoNewPrivileges=true
UMask=0077
