[Unit]
Description=LCARLIE Meta reklam izleme - tum hesap, reklam/yerlesim DB'ye, yeni uyari push+e-posta (YALNIZ OKUR)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/lcarlie/jarvis-phase2
EnvironmentFile=/etc/lcarlie/jarvis-web.env
EnvironmentFile=/etc/lcarlie/google-oauth.env
EnvironmentFile=/etc/lcarlie/siparis-nobetci.env
Environment=JARVIS_STATE_DIR=/opt/lcarlie/jarvis-phase2/state
ExecStart=/usr/bin/flock -w 120 /run/lcarlie-meta-reklam-izle.lock /opt/lcarlie/jarvis-phase2/venv/bin/python /opt/lcarlie/jarvis-phase2/scripts/meta-reklam-izle.py
TimeoutStartSec=600
NoNewPrivileges=true
UMask=0077
