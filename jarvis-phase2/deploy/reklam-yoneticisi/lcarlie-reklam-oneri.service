[Unit]
Description=LCARLIE reklam uzman ikilisi - kreatif onbellegi (her saat) + oneri (09:25/18:25 + yeni KRITIK uyari). YALNIZ OKUR VE ONERIR
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/lcarlie/jarvis-phase2
EnvironmentFile=/etc/lcarlie/jarvis-web.env
Environment=JARVIS_STATE_DIR=/opt/lcarlie/jarvis-phase2/state
ExecStart=/usr/bin/flock -w 120 /run/lcarlie-reklam-oneri.lock /opt/lcarlie/jarvis-phase2/venv/bin/python /opt/lcarlie/jarvis-phase2/scripts/reklam-oneri.py
TimeoutStartSec=900
NoNewPrivileges=true
UMask=0022
