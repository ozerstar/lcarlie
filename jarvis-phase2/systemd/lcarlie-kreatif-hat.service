[Unit]
Description=L.CARLIE haftalik kreatif partisi - tum urunler icin brief ve promptlar (gorsel URETMEZ)
After=network-online.target docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/lcarlie/jarvis-phase2
Environment=JARVIS_MEMORY_TRANSPORT=local-docker
ExecStart=/bin/bash /opt/lcarlie/jarvis-phase2/scripts/kreatif-parti.sh
# 25.09.2026 OLCULDU: 10800 (3 saat) YETMIYOR. Parti 36 urun isliyor ve
# urun basina ~4,9 dk suruyor -> ~3 saat 5 dk. 02:19 kosusu TAM bitis
# cizgisinde (36 urunu isledikten sonra) zaman asimiyla oldurulmustu.
# Sonuc: parti bugune kadar UC kez basladi, SIFIR kez tamamlandi.
# 18000 (5 saat) olculen sureye rahat pay birakir; sinirsiz degil,
# cunku asili kalan bir kosu da fark edilmeli.
TimeoutStartSec=18000
StandardOutput=append:/opt/lcarlie/jarvis-phase2/state/kreatif-hat.log
StandardError=append:/opt/lcarlie/jarvis-phase2/state/kreatif-hat.log
