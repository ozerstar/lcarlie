[Unit]
# 🔴 SAHIP KARARI 21.09.2026: "zamanlayici onemli, 4 gunde 1 calissin."
Description=Kreatif partisi - 4 gunde bir

[Timer]
# 🔴 25.09.2026 ONARIMI. Onceki hali YALNIZ OnUnitActiveSec=4d idi ve
# bu tek basina HIC ATESLEMIYORDU: OnUnitActiveSec servisin son
# aktivasyonuna gore olculur, servis o boot'ta hic aktive olmadiysa
# capa noktasi olmaz ve systemd tetik planlamaz ("Trigger: n/a").
# Olculdu: hat 21.09'dan 25.09'a kadar bir kez bile kosmadi.
#
# Artik GUNLUK uyandirma var; gercek 4 gunluk arayi BETIK koruyor
# (kreatif-parti.sh basindaki damga kontrolu). Boylece:
#   * capa sorunu yok        - takvim tetigi her gun planlanir
#   * ay sonu duzensizligi yok - gunluk, ayin gunlerine sabitlenmedi
#   * yeniden baslatma kosu emri DEGIL - damga 4 gunu doldurmadiysa cikar
#   * kacirilan tetigi telafiye gerek yok: gunluk, ertesi gun zaten uyandirir.
#     🔴 Persistent=true KULLANMA - 25.09.2026da denendi ve timer restartinda
#     kacirilmis 10:00 tetigini ANINDA telafi edip tam partiyi baslatti.
OnCalendar=*-*-* 10:00:00
RandomizedDelaySec=900

[Install]
WantedBy=timers.target
