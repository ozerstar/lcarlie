SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# DOCKER_API_VERSION KALDIRILDI 20.09.2026: docker 24->29 yukseltmesi minimum
# API surumunu 1.44 yapti, buradaki 1.43 sabitlemesi her docker cagrisini
