# LCARLIE - aylik yedek saglamlik testi (her ayin 1i 04:30, IZOLE)
# 🔴 16.09.2026: IZOLE surume gecildi. Onceki hali yedegi URETIM postgres
#    konteynerinin icinde n8n_test veritabanina yukluyordu - "canli veriye
#    dokunulmadi" dogruydu ama izole degildi. Yeni betik ayri, aga kapali,
#    tmpfs uzerinde gecici bir konteyner kullanir ve core/raw/mart
#    semalarini da dogrular.
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# DOCKER_API_VERSION KALDIRILDI 20.09.2026: docker 24->29 yukseltmesi minimum
# API surumunu 1.44 yapti, buradaki 1.43 sabitlemesi her docker cagrisini
# "client version 1.43 is too old" ile dusurdu. Sabitleme yok: istemci
# surumu sunucuyla kendisi anlasir, bir sonraki yukseltmede tekrar kirilmaz.
CRON_TZ=Europe/Istanbul
30 4 1 * * root flock -n /var/lock/lcarlie-restore-test.lock /opt/lcarlie/backup/geri-yukle-IZOLE-TEST.sh >> /opt/lcarlie/backup/log/test-restore.log 2>&1
