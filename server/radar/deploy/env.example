# /opt/lcarlie/radar/.env  (chmod 600) — gizli anahtarlar burada, config.json'da değil
RADAR_CONFIG=/opt/lcarlie/radar/config.json
# Kill-switch: false yapılırsa zamanlayıcılar hiçbir şey çalıştırmaz.
RADAR_ENABLED=true

# Rakip tarama ajanı (Jarvis venv'i; Gemini anahtarı Jarvis'in kendi .env'inden okunur — burada anahtar YOK).
JARVIS_AGENT_CMD="/opt/lcarlie/jarvis-phase2/venv/bin/python /opt/lcarlie/radar/deploy/jarvis_rakip_ajani.py"
RADAR_SORGU_ADEDI=4
RADAR_SAYFA_SINIRI=12
# Liste sayfaları ve JSON-LD modelsiz okunur; model yalnız son çare. Önce OpenRouter ÜCRETSİZ, sonra yerel model.
IS_URETICI_GUCLU_ISLER=rakip-sentez,kreatif-uret,b2b-plan,is-uretici-aylik,radar-cikar
IS_URETICI_UCRETLI=false

# ---------- Sabah özetini size iletmek (birini doldurmanız yeterli; boşsa yalnız Jarvis panelinde) ----------
# Telegram (resmi, ücretsiz): Telegram'da @BotFather -> /newbot -> verilen token buraya;
# sonra bota bir mesaj yazın ve config.json'da owner.telegram_chat_id'yi doldurun (kur betiği yol gösterir).
TELEGRAM_BOT_TOKEN=
# WhatsApp (açık kaynak WAHA, github.com/devlikeapro/waha): sunucuda docker ile çalışır, telefonla QR okutulur.
# Resmi olmayan istemcidir; yalnız KENDİ numaranıza özet için önerilir (toplu gönderim numara engeli riski).
WAHA_URL=
WAHA_API_KEY=
WAHA_SESSION=default

# ---------- Satış verisi (sabah özetine dünkü sipariş/tutar) ----------
# Wix: Ana Panel > Ayarlar > API Anahtarları > yeni anahtar, izin: "Read Orders" (Wix Stores/eCommerce).
WIX_API_KEY=
WIX_SITE_ID=20b24639-9d03-4307-8b5d-2a525af26151
# Trendyol satıcı paneli > Hesap Bilgilerim > Entegrasyon Bilgileri (Satıcı ID, API Key, API Secret).
TRENDYOL_SATICI_ID=
TRENDYOL_API_KEY=
TRENDYOL_API_SECRET=

# Google Places KAPALI (ücretli). Eczane adayları OpenStreetMap'ten (ücretsiz) gelir: config.json leads.kaynak=osm.
GOOGLE_PLACES_API_KEY=

# İçerik taslağı KAPALI (zamanlayıcısı kurulmaz): içerik Jarvis'in kreatif programında (PubMed + hakem).
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Eski genel webhook (WAHA kullanılmıyorsa) ve e-posta (Gmail uygulama şifresi) — isteğe bağlı.
JARVIS_WHATSAPP_WEBHOOK=
SMTP_HOST=smtp.gmail.com
SMTP_USER=
SMTP_PASS=
