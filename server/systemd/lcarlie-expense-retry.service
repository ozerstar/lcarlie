[Unit]
Description=Retry user-requested monthly expense delivery
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
Environment=JARVIS_DB_HOST=127.0.0.1
Environment=JARVIS_DB_PORT=5433
Environment=JARVIS_DB_PASSWORD_FILE=/etc/lcarlie/jarvis-web-db.pass
Environment=JARVIS_EXPENSE_OWNER=operator
ExecStart=/opt/lcarlie/jarvis-phase2/venv/bin/python /opt/lcarlie/jarvis-phase2/tools/expense_jobs.py retry-pending
TimeoutStartSec=45min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict

