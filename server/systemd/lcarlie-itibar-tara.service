[Unit]
Description=LCARLIE itibar/basin taramasi (grounded arama + Turkce NER)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/lcarlie/jarvis-phase2
ExecStart=/opt/lcarlie/jarvis-phase2/venv/bin/python /opt/lcarlie/jarvis-phase2/scripts/itibar-tara.py
# Yalnizca okur ve core.basin_bahsi'ne yazar; dis eylem yok.
TimeoutStartSec=1800
Nice=10
