[Unit]
Description=L'CARLIE saglik toplayiciyi zamanla

[Timer]
# 15 dakika: workflow hatasini gormek icin yeterince sik, alarm dedup
# penceresini bogmayacak kadar seyrek. saglik.sh kendi icinde "toplayici
# bir sure calismadi" kontrolu yapiyor; bu aralik o kontrolun beklentisiyle
# uyumlu.
OnBootSec=6min
OnUnitActiveSec=15min
RandomizedDelaySec=45s
AccuracySec=15s
Persistent=false
Unit=lcarlie-saglik.service

[Install]
WantedBy=timers.target
