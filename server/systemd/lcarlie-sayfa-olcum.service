Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/lcarlie/seo-araclari
ExecStart=/usr/bin/python3 /opt/lcarlie/seo-araclari/sayfa-olcum.py
ExecStart=/usr/bin/python3 /opt/lcarlie/seo-araclari/sayfa-yukle.py
TimeoutStartSec=900
